# R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Environment variables (may hold API keys, DB credentials)
.Renviron

# Quarto scratch: index, caches, session state, and the hidden duplicate of the
# freeze data. The frozen computations CI actually reads live in the
# project-root `_freeze/` directory (see "Publishing" in README) — that one is
# committed. This `.quarto/` directory is local-only, so ignore it wholesale.
#
# Written as `/.quarto/` (leading slash, trailing slash) deliberately: Quarto's
# own ensureGitignore() appends exactly this entry on every render, so matching
# its form exactly keeps it from re-adding the line and dirtying .gitignore.
/.quarto/

# knitr / Quarto caches
*_cache/
*_files/

# Analysis outputs (regenerated on every render)
output/figures/*.png
output/tables/*.csv

# Rendered site: rebuilt by CI, served from the gh-pages branch.
# A website project renders into _site/ by default (libDir site_libs/ lives
# inside it), so this one rule covers the whole build output.
_site/

# NOTE: the project-root `_freeze/` directory is deliberately NOT ignored.
# It holds the frozen R results that CI thaws from to render without R, so it
# must be committed. Do not add a `_freeze/` rule here.

# OS
.DS_Store
Thumbs.db

# Quarto junk that may be dropped next to a document
**/*.quarto_ipynb
