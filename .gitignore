# R session state
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Environment variables (may hold API keys, DB credentials)
.Renviron

# Quarto
.quarto/
*_cache/
*_files/

# Analysis outputs (regenerated on every render)
output/figures/*.png
output/tables/*.csv

# Rendered report (rebuilt by CI; the published copy is served from gh-pages)
analysis/report.html

# renv's own library is ignored by renv/.gitignore, no need to repeat it here

# OS
.DS_Store
Thumbs.db
